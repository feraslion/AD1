{
  "name": "ad1-erp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "bun run build",
    "build:windows": "bun run build:web && bunx electron-builder --win --publish never",
    "build:android": "bun run build:web && bunx cap sync android && (cd android && ./gradlew assembleRelease)",
    "build:all": "bun run build:web && bun run build:windows && bun run build:android",
    "app:build:release": "npm run build && npx cap sync && npx cap build android --flavor release",
    "start": "node dist/server.cjs",
    "clean": "node -e \"['dist','server.js','release'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun src/tests/test_phase8_currency.ts && bun src/tests/test_phases9_10_11.ts && bun src/tests/test_phases12_13_14_15.ts",
    "test:light": "bun src/tests/test_phases7_engine.ts",
    "benchmark": "bun src/harness/benchmark.ts",
    "ci:pipeline": "npm run lint && npm run build && npm run test:light && npm run benchmark"
  },
  "build": {
    "appId": "com.feraslion.ad1",
    "productName": "AD1-ERP",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "dist/server.cjs",
      "dist/**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
